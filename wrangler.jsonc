{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trading-bot-extractor",
  "main": "worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Private bucket for extracted XML and bulk ZIPs. Create it once: `npx wrangler r2 bucket create trading-bot-extractor`
  "r2_buckets": [{ "binding": "RESULTS", "bucket_name": "trading-bot-extractor" }],
  // Every minute: retry/finish extraction jobs and create jobs for paid orders the webhook missed.
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "DOWNLOAD_TTL_SECONDS": "900",
    "MAX_UPLOAD_BYTES": "10485760",
    "MAX_SOURCE_BYTES": "10485760",
    "MAX_JOB_ATTEMPTS": "3",
    "MAX_FETCHES_PER_JOB": "14"
  }
  // Secrets (never in this file): `npx wrangler secret put <NAME>` for
  // SUPABASE_SERVICE_ROLE_KEY, PAYHERO_API_USERNAME, PAYHERO_API_PASSWORD, PAYHERO_WEBHOOK_SECRET,
  // DOWNLOAD_SIGNING_SECRET and (optional) CF_BROWSER_RENDERING_TOKEN.
  // Plain vars to set in the dashboard or here: NEXT_PUBLIC_SITE_URL, NEXT_PUBLIC_SUPABASE_URL, PAYHERO_* config, CF_ACCOUNT_ID.
}
