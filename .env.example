# Web
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local dev uses .dev.vars (copy these values there). On Cloudflare: plain values as Worker vars,
# secrets via `npx wrangler secret put NAME`. NEXT_PUBLIC_* must also exist at BUILD time.
# Extraction engine (optional tuning; defaults are in wrangler.jsonc)
MAX_SOURCE_BYTES=10485760
MAX_JOB_ATTEMPTS=3
MAX_FETCHES_PER_JOB=14
DNS_CHECK=on
# Optional: Cloudflare Browser Rendering (REST) for JavaScript-rendered pages. Token needs "Browser Rendering: Edit".
CF_ACCOUNT_ID=
CF_BROWSER_RENDERING_TOKEN=

# Storage: results are kept in Supabase Postgres (extraction_jobs.result_xml) and purged after this many days.
RESULT_RETENTION_DAYS=30

# PayHero Kenya (https://payhero.co.ke) — M-Pesa STK Push
# API username/password: app.payhero.co.ke -> API Keys.  Channel ID: Payment Channels -> My Payment Channels.
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CHANNEL_ID=
PAYHERO_PROVIDER=m-pesa
# Optional override (default https://backend.payhero.co.ke/api/v2)
PAYHERO_BASE_URL=
# Long random string (e.g. `openssl rand -hex 32`). Signs the callback URL so forged webhooks are rejected.
PAYHERO_WEBHOOK_SECRET=

# Email
RESEND_API_KEY=
EMAIL_FROM=

# Pricing
SINGLE_EXTRACTION_PRICE_KES=100
BULK_10_PRICE_KES=900
BULK_25_PRICE_KES=2000
BULK_50_PRICE_KES=3750
BULK_100_PRICE_KES=7000

# Security
DOWNLOAD_TTL_SECONDS=900
MAX_UPLOAD_BYTES=10485760
MAX_BULK_ITEMS=100
